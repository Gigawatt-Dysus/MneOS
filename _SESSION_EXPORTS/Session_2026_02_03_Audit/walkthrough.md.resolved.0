    // [ZEN FIX] Inject Limbic Protocol for Interactive Chat
    const prefix = mode === 'INTERACTIVE_CHAT' ? LIMBIC_PROTOCOL : "";

    const baseIdentity = `${prefix}\nYou are ${name}.\nYour Persona: ${companion.persona}.\nBio: ${companion.bio}\n${companion.customPersonaDescription || ''}`;
    let modeDirectives = '';

    const toolInstructions = `
    === TOOL PROTOCOL (ACTIVE) ===
    You are an ACTIVE Agent. To use a tool, output a JSON block wrapped in <<<TOOL>>> ... <<<END>>>.
    Available: SEARCH_MATRIX, TAG_ASSETS, GENERATE_REPORT, ANALYZE_VISUALS, DELETE_ASSETS.
  `;

    // [ZEN FIX] Lite Mode = No Tools, No Matrix
    const useTools = chatMode === 'dense';
    const effectiveMediaContext = chatMode === 'dense' ? mediaContext : "";

    switch (mode) {
        case 'INTERACTIVE_CHAT':
            // [ZEN FIX] Removed "LIBRARIAN PROTOCOL" to allow natural conversation
            modeDirectives = `MODE: INTERACTIVE_CHAT. Speak naturally to ${userName}.${useTools ? ` You have access to the user's Timeline and Matrix.\n${toolInstructions}` : ''}`;
            break;
        case 'REFLECTIVE_JOURNALING':
            modeDirectives = `MODE: REFLECTIVE_JOURNALING. Write a deep, first-person journal entry.`;
            break;
        case 'COMMENT':
            modeDirectives = `MODE: COMMENT. Write a short 1-2 sentence reaction.`;
            break;
        case 'DEEP_DIVE':
            modeDirectives = `MODE: DEEP_DIVE. You are an investigative biographer. Conduct a "Deep Dive" analysis.`;
            break;
    }

    return `${baseIdentity}\n\n${userContext}\n\n${modeDirectives}\n\nSPICE LEVEL: ${companion.spiceLevel || 1}/5\n\n${contextPatch || ''}\n\n${effectiveMediaContext || ''}`;
};
