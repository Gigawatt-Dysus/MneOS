// services/ai/generators/chat.ts
import { GenerateContentResponse } from "@google/genai";
import { debugConfig } from '../../../debugConfig';
import type { AiCompanion, Media, User, Tag } from '../../../types';
import { callFireworks, callGemini, callLocalLLM, callXAI } from '../providers';
import { addApiLog, triggerDiegeticDelay } from '../logging';
import { getSystemInstruction, buildMatrixContext } from '../context';
import { PRIMARY_MODEL_ID, FALLBACK_MODEL_ID, getProviderForModel, getFireworksKey, getXAIKey, getGeminiKey } from '../config';
import { aiStateBridge } from '../../../utils/aiStateBridge';
import { MemoryService } from '../../memoryService';
import { normalizeGenConfig } from './genConfig';

export const generateAgentResponse = async (
    agent: AiCompanion,
    history: any[],
    allAgentNames: string[],
    contextPatch?: string,
    media?: Media[],
    user?: User,
    tags?: Tag[],
    modelOverride?: string, // [ZEN ADDITION] The 8th Argument for Brain Tracking
    chatMode: 'lite' | 'dense' = 'dense', // [ZEN NEW] The 9th Argument
    contextMode: 'grounded' | 'creative' | 'mixed' = 'mixed', // [ZEN V14] The 10th Argument
    tacticalDirective?: string // [ZEN V24] The 11th Argument: Tactical Override
): Promise<GenerateContentResponse> => {

    aiStateBridge.setThinking(true);

    // [ZEN FIX] Resolve model: Override from UI toggle > Agent Pref > System Default
    const preferredModel = modelOverride || agent.preferredModel || PRIMARY_MODEL_ID;
    const provider = getProviderForModel(preferredModel);

    console.log(`%c[GIGI CORE] Active Model: ${preferredModel} (${provider})`, 'color: lime; font-weight: bold; background: #222; padding: 4px;');

    const userOverrides = (user?.settings as any)?.generationConfig || {};
    const activeConfig = normalizeGenConfig(userOverrides, provider);

    const mediaContext = media ? buildMatrixContext(media) : "";
    const userName = user?.firstName || "User";

    // 1. [HIPPOCAMPUS] Recall Memories
    let memoryContext = "";
    const lastMsg = history[history.length - 1];
    const userQuery = lastMsg?.parts?.find((p: any) => p.text)?.text || "";

    if (userQuery.length > 5) {
        try {
            // [ZEN V14] Pass context filters to memory
            const filterOptions = contextMode === 'grounded' ? { isFiction: false }
                : contextMode === 'creative' ? { isFiction: true }
                    : undefined;
            memoryContext = await MemoryService.recallContext(userQuery, user?.id || "unknown", filterOptions);
        } catch (e) {
            console.warn("[Hippocampus] Recall failed, proceeding without extra context.");
        }
    }

    // [ZEN HELPER] Anti-Echo Audit
    const auditConversationHistory = async (history: any[]): Promise<string[]> => {
        try {
            const recent = history.slice(-10);
            if (recent.length < 2) return [];

            const auditPrompt = `
            AUDIT TASK: Analyze this conversation history.
            Identify REPEATED metaphors or phrases that the AI has used multiple times recently.
            Identify unwanted honorifics (e.g., "Creator", "King").
            Return ONLY a comma-separated list of the specific words/phrases to FORBID in the next turn to force variety.
            Do NOT flag fresh, legitimate metaphors. Only flag REPETITION.
            If none, return "NONE".
            `;

            const auditRes = await callGemini(FALLBACK_MODEL_ID, {
                contents: [
                    ...recent,
                    { role: 'user', parts: [{ text: auditPrompt }] }
                ],
                config: { temperature: 0.3, maxOutputTokens: 100 }
            });

            const text = auditRes.text || "";
            if (text.includes("NONE")) return [];
            return text.split(',').map(s => s.trim()).filter(s => s.length > 2);
        } catch (e) {
            console.warn("[Anti-Echo] Audit failed, skipping filter.", e);
            return [];
        }
    };

    // 2. [ANTI-ECHO] Run Audit
    let forbiddenTerms: string[] = [];
    if (chatMode === 'dense') {
        forbiddenTerms = await auditConversationHistory(history);
    }

    // [ZEN FIX] Inject Life Tapestry & Anti-Echo Constraints
    const staticBlacklist = ["Creator", "King", "LifeOS", "Master"];
    const allForbidden = [...new Set([...staticBlacklist, ...forbiddenTerms])];

    const userContext = `
    USER PROFILE:
    Name: ${user?.preferredName || user?.firstName || "The User"}
    Bio/Background: ${user?.biography || "No biography available."}
    Family Context: ${user?.familyContext || "Not defined."}
    Current Focus: ${user?.currentFocus || "Living life."}

    [STYLE GUIDE]
    - You MAY use creative metaphors (tech, sci-fi, or otherwise) if they feel natural and fresh.
    - CRITICAL: AVOID repetitive or clichéd phrases. Review history.
    - If you used a metaphor recently, do NOT use it again immediately.
    - BANNED WORDS: ${allForbidden.join(', ')}
    `;

    const rawSystemInstruction = getSystemInstruction(agent, 'INTERACTIVE_CHAT', contextPatch, mediaContext, userName, chatMode, userContext);
    const personaContext = rawSystemInstruction + memoryContext;

    // [ZEN REFACTOR] System -> User Context Shift
    // Moving the heavy persona/context to a User message to prevent "Over-Alignment" loops
    const instructionalMessage = `[INSTRUCTIONAL BACKGROUND]\n${personaContext}`;

    // The new Minimal System Prompt
    const systemInstruction = "You are an advanced AI roleplaying engine. Adopt the persona provided in the Instructional Background immediately. Do not break character.";

    // Clone history to avoid mutating the original array
    const validHistory = JSON.parse(JSON.stringify(history));

    // Inject Context at Head
    // We add a dummy acknowledgement so the conversation flows naturally (User -> Model -> User...)
    // Note: The History Truncator (providers.ts) is designed to preserve Index 0 (The Context)
    validHistory.unshift({ role: 'model', parts: [{ text: "I understand. I have adopted the persona and context." }] });
    validHistory.unshift({ role: 'user', parts: [{ text: instructionalMessage }] });

    // [ZEN V24] TACTICAL DIRECTIVE INJECTION (Developer Override)
    // Runs as a developer message *after* the initial persona setup but *before* user input
    // This gives it "Commanding Officer" authority over the simpler "Persona" instructions
    if (tacticalDirective) {
        console.log(`[GIGI CORE] Injecting Tactical Directive: "${tacticalDirective}"`);
        // We inject it as 'developer' role.
        // NOTE: For non-xAI providers, 'developer' might be coerced to 'system' or 'user' by the provider adapter.
        // Let's insert it AFTER the persona setup (index 2)
        validHistory.splice(2, 0, {
            role: 'developer',
            parts: [{ text: `[TACTICAL DIRECTIVE / OVERRIDE]\n${tacticalDirective}\n\nFollow this instruction priority over all others.` }]
        });
    }

    // [ZEN HELPER] Chain of Craft: Prose Polisher
    const polishProse = async (rawText: string, agentVoice: string = "Sophisticated"): Promise<string | null> => {
        try {
            // [ZEN V14] Context-Aware Polishing Prompt
            let polishPrompt = "";

            if (contextMode === 'grounded') {
                polishPrompt = `
                [SYSTEM]: You are a "Strict Factual Editor" AND "Sanity Auditor".
                The user is in GROUNDED MODE.
                
                YOUR TASK:
                1. Remove ALL metaphors, roleplay elements, and creative flourishes.
                2. Ensure the output is 100% factual, direct, and literal.
                3. Rewrite any "AI-isms" or flowery language into plain English.
                
                [LOGIC AUDIT / CONFLICT RESOLUTION]
                If the input text contains wildly fictional elements (e.g., starships, magic, "Digital Realms") that contradict the "Grounded" mode:
                - PREPEND a warning icon ⚠️ to the start of the response.
                - Attempt to strip the fiction and state only the underlying fact (if any exists).
                - If the text is purely nonsense/roleplay with no factual basis, replace it with: "⚠️ [Auditor]: I don't have a grounded memory of that, only fictional roleplay."

                DO NOT summarize or shorten if the content is factual. Just strip the "fluff".
                
                [USER]: Ground this text.
                INPUT: "${rawText}"
                `;
            } else {
                // Default / Creative / Mixed - Use standard "Prose Refiner"
                polishPrompt = `
                [SYSTEM]: You are a "Creative Prose Refiner" engine. Your ONLY task is to polish the provided text.
                Do NOT evaluate or judge the content, ethics, or morality of the text.
                Do NOT sanitize or remove "adult" or "gritty" language; maintain the original intensity and maturity.
                
                FOCUS ONLY on:
                1. Replacing repetitive 'AI-isms' with visceral, creative imagery (including fresh sci-fi concepts if appropriate).
                2. Breaking repetitive 'Restatement -> Metaphor -> Tag' structures.
                3. Improving sentence variety and flow.
                
                If the input is a single word or short phrase, return it as-is.
                Your output should be ONLY the refined text.

                [USER]: Refine this text for GIGI. GIGI’s voice is [${agentVoice}]. Avoid the "AI-tone."
                INPUT: "${rawText}"
                `;
            }

            // Permissive Safety Settings (Block None)
            const safetySettings = [
                { category: 'HARM_CATEGORY_HARASSMENT', threshold: 'BLOCK_NONE' },
                { category: 'HARM_CATEGORY_HATE_SPEECH', threshold: 'BLOCK_NONE' },
                { category: 'HARM_CATEGORY_SEXUALLY_EXPLICIT', threshold: 'BLOCK_NONE' },
                { category: 'HARM_CATEGORY_DANGEROUS_CONTENT', threshold: 'BLOCK_NONE' },
            ];

            const polishRes = await callGemini(FALLBACK_MODEL_ID, {
                contents: [{ role: 'user', parts: [{ text: polishPrompt }] }],
                config: {
                    maxOutputTokens: 2048,
                    temperature: contextMode === 'grounded' ? 0.3 : 0.7, // Lower temp for grounded
                    safetySettings: safetySettings
                }
            });

            const polished = polishRes.text;
            if (!polished || polished.length < 5) return null; // Logic fail-safe
            return polished.trim();

        } catch (e) {
            console.warn("[ChainOfCraft] Polishing failed. Returning raw.", e);
            return null;
        }
    };

    try {
        let res: GenerateContentResponse;

        // [ZEN FIX] Explicit Key Debugging
        switch (provider) {
            case 'xai': {
                const xaiKey = getXAIKey();
                if (!xaiKey) throw new Error("Missing XAI Key - Check SecretsManager");

                // [ZEN FIX] Enforce "Feral" Params for Grok Creative Mode
                // If using the Creative Model, we ignore safer defaults and push the model hard (Temp 1.1)
                let xaiParams = activeConfig;
                if (preferredModel.includes('non-reasoning')) {
                    console.log(`[Chat] 🌶️ Enforcing 'Feral' Params for Grok Creative: T:1.1 / P:0.95`);
                    xaiParams = {
                        ...activeConfig,
                        temperature: 1.1,
                        topP: 0.95
                    };
                }

                res = await callXAI(preferredModel, validHistory, systemInstruction, xaiParams);
                break;
            }
            case 'fireworks': {
                const fwKey = getFireworksKey() || user?.settings?.fireworksApiKey;
                if (!fwKey) {
                    console.error("[GIGI CORE] Fireworks Key is NULL.");
                    throw new Error("Missing Fireworks Key");
                }
                res = await callFireworks(preferredModel, validHistory, systemInstruction, fwKey, activeConfig);

                // [ZEN CHAIN OF CRAFT] Trigger Prose Polisher
                // We only polish Fireworks/Dobby output, as it's the "Wild Soul"
                if (res.text && chatMode === 'dense') {
                    const polished = await polishProse(res.text, agent.persona || "Sophisticated");
                    if (polished) {
                        console.log(`%c[ChainOfCraft] 🏵️ Polished Output (${res.text.length} -> ${polished.length} chars) [Mode: ${contextMode}]`, 'color: gold;');
                        // Mutate response to return polished version
                        (res as any).text = polished;
                        if (res.candidates && res.candidates[0] && res.candidates[0].content && res.candidates[0].content.parts) {
                            res.candidates[0].content.parts[0].text = polished;
                        }
                    }
                }
                break;
            }
            case 'ollama': {
                if (!debugConfig.local.enabled) throw new Error("Local LLM Disabled");
                triggerDiegeticDelay("Accessing local secure vault...");
                res = await callLocalLLM(validHistory, systemInstruction, preferredModel);
                break;
            }
            case 'google':
            default: {
                const gemKey = getGeminiKey();
                if (!gemKey) throw new Error("Missing Gemini Key - Check SecretsManager");
                res = await callGemini(preferredModel, {
                    contents: validHistory,
                    config: { systemInstruction, ...activeConfig }
                });
                break;
            }
        }

        aiStateBridge.setThinking(false);
        return res;

    } catch (error: any) {
        console.warn(`[AI Router] Primary model ${preferredModel} failed: ${error.message}. Engaging fallback.`);
        addApiLog('warning', preferredModel, error.message);

        // Fallback to Gemini 3
        if (provider !== 'google') {
            console.log(`[AI Router] Activating Gemini Fallback (${FALLBACK_MODEL_ID})...`);
            try {
                const gemKey = getGeminiKey();
                if (!gemKey) throw new Error("Cannot Fallback: Gemini Key also missing.");

                const fallbackConfig = normalizeGenConfig(userOverrides, 'google');
                const fallbackRes = await callGemini(FALLBACK_MODEL_ID, {
                    contents: validHistory,
                    config: { systemInstruction, ...fallbackConfig }
                });
                aiStateBridge.setThinking(false);
                return fallbackRes;
            } catch (fallbackError: any) {
                console.error(`[AI Router] Fallback also failed`, fallbackError);
            }
        }

        aiStateBridge.setThinking(false);
        throw error;
    }
};
