rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // [THE PROFESSIONAL CORRIDOR]
    // Allow unauthenticated reads for the Recruiter Hub / ATS Proxy
    match /public_slugs/{slug} {
      allow get: if true; // Allow direct lookup by slug
      allow list: if false; // BLOCK mass scraping of all slugs
    }
    
    match /users/{userId} {
      allow get: if true; // Allow direct lookup by userId
      allow list: if request.auth != null; // BLOCK mass scraping of the user database
      
      // Allow the ATS to fetch a specific user's public media and events
      match /events/{eventId} {
        allow read: if true;
      }
      match /media/{mediaId} {
        allow read: if true;
      }
    }

    // [DEFAULT SECURITY]
    // Everything else requires authentication
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
