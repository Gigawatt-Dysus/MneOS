{
  "version": 2,
  "devCommand": "npm run dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|favicon.png|manifest.json|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
